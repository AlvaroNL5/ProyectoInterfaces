<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="600.0" prefWidth="480.0"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.javafx.A_holamundofxml.CrearUsuarioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <VBox spacing="14.0" maxWidth="420" styleClass="settings-card">
        <padding>
            <Insets bottom="22.0" left="22.0" right="22.0" top="22.0"/>
        </padding>

        <Label text="Crear Cuenta" styleClass="page-title"
               style="-fx-text-fill: #1e3a8a;"/>
        <Label text="Regístrate como alumno en Muudle" styleClass="text-secondary"
               style="-fx-font-size: 12px;">
            <VBox.margin><Insets bottom="6.0"/></VBox.margin>
        </Label>

        <HBox spacing="10.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Nombre"/>
                <TextField fx:id="txtNombre" promptText="Tu nombre">
                    <tooltip><Tooltip text="Introduce tu nombre"/></tooltip>
                </TextField>
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Apellidos"/>
                <TextField fx:id="txtApellidos" promptText="Tus apellidos">
                    <tooltip><Tooltip text="Introduce tus apellidos"/></tooltip>
                </TextField>
            </VBox>
        </HBox>

        <VBox spacing="5.0">
            <Label text="Email"/>
            <TextField fx:id="txtEmail" promptText="ejemplo@correo.com">
                <tooltip><Tooltip text="Tu email (será tu usuario para iniciar sesión)"/></tooltip>
            </TextField>
        </VBox>

        <HBox spacing="10.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Contraseña"/>
                <PasswordField fx:id="txtPassword" promptText="Mínimo 4 caracteres">
                    <tooltip><Tooltip text="Mínimo 4 caracteres"/></tooltip>
                </PasswordField>
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Confirmar"/>
                <PasswordField fx:id="txtConfirmarPassword" promptText="Repite la contraseña">
                    <tooltip><Tooltip text="Repite tu contraseña"/></tooltip>
                </PasswordField>
            </VBox>
        </HBox>

        <VBox spacing="5.0">
            <Label text="Edad"/>
            <TextField fx:id="txtEdad" promptText="0-150">
                <tooltip><Tooltip text="Tu edad (0-150)"/></tooltip>
            </TextField>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <VBox.margin><Insets top="10.0"/></VBox.margin>
            <Region HBox.hgrow="ALWAYS"/>
            <Button cancelButton="true" mnemonicParsing="true" onAction="#handleCancelar"
                    text="Ca_ncelar" styleClass="btn-secondary">
                <tooltip><Tooltip text="Cancelar y volver"/></tooltip>
            </Button>
            <Button fx:id="btnCrear" mnemonicParsing="true" onAction="#handleCrear"
                    text="_Crear cuenta">
                <tooltip><Tooltip text="Registrar la nueva cuenta"/></tooltip>
            </Button>
        </HBox>
    </VBox>
</StackPane>
