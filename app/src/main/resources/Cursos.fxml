<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="980.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javafx.A_holamundofxml.CursosController">

    <!-- ===== HEADER ===== -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
            <Label text="MUUDLE" styleClass="header-logo">
                <HBox.margin><Insets left="4"/></HBox.margin>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="1">
                <Label fx:id="lblNombreUsuario" styleClass="header-user-name"/>
                <Label fx:id="lblTipoUsuario" styleClass="header-user-role"/>
            </VBox>
        </HBox>
    </top>

    <!-- ===== SIDEBAR ===== -->
    <left>
        <VBox styleClass="sidebar" prefHeight="670.0" spacing="6.0">
            <padding><Insets top="14.0" left="8.0" right="8.0" bottom="10.0"/></padding>

            <!-- PRINCIPAL -->
            <Label text="PRINCIPAL" styleClass="sidebar-section-label" />
            <Button fx:id="btnCursos" text="Inicio" styleClass="nav-btn"
                    mnemonicParsing="false">
                <tooltip><Tooltip text="Ver mis cursos"/></tooltip>
            </Button>
            <Button fx:id="btnNoticias" text="Noticias" styleClass="nav-btn"
                    mnemonicParsing="false">
                <tooltip><Tooltip text="Noticias educativas"/></tooltip>
            </Button>

            <!-- APRENDIZAJE -->
            <Label text="APRENDIZAJE" styleClass="sidebar-section-label" />
            <Button fx:id="btnTareas" text="Tareas" styleClass="nav-btn"
                    mnemonicParsing="false">
                <tooltip><Tooltip text="Tareas y entregas"/></tooltip>
            </Button>
            <Button fx:id="btnForo" text="Foro" styleClass="nav-btn"
                    mnemonicParsing="false">
                <tooltip><Tooltip text="Foro de discusión"/></tooltip>
            </Button>
            <Button fx:id="btnControlAsistencia" text="Asistencia" styleClass="nav-btn"
                    mnemonicParsing="false">
                <tooltip><Tooltip text="Control de asistencia"/></tooltip>
            </Button>

            <!-- GESTIÓN (solo profesor) -->
            <Label fx:id="lblSeccionGestion" text="GESTIÓN" styleClass="sidebar-section-label" />
            <Button fx:id="btnUsuarios" text="Usuarios" styleClass="nav-btn"
                    mnemonicParsing="false">
                <tooltip><Tooltip text="Gestión de usuarios"/></tooltip>
            </Button>
            <Button fx:id="btnAsistencias" text="Matriculación" styleClass="nav-btn"
                    mnemonicParsing="false">
                <tooltip><Tooltip text="Gestionar matriculaciones"/></tooltip>
            </Button>
            <Button fx:id="btnInformes" text="Informes" styleClass="nav-btn"
                    mnemonicParsing="false">
                <tooltip><Tooltip text="Generar informes PDF"/></tooltip>
            </Button>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Bottom -->
            <Separator>
                <VBox.margin><Insets top="4.0" bottom="4.0" left="4.0" right="4.0"/></VBox.margin>
            </Separator>
            <Button fx:id="btnAjustes" text="Ajustes" styleClass="nav-btn"
                    mnemonicParsing="false">
                <tooltip><Tooltip text="Configuración de la aplicación"/></tooltip>
            </Button>
            <Button fx:id="btnCerrarSesion" text="Cerrar sesión" styleClass="nav-btn-danger"
                    mnemonicParsing="false">
                <tooltip><Tooltip text="Cerrar sesión y volver al login"/></tooltip>
            </Button>
        </VBox>
    </left>

    <!-- ===== CONTENT AREA ===== -->
    <center>
        <StackPane>

            <!-- ==== INICIO: Cursos como tarjetas ==== -->
            <VBox fx:id="vboxCursos" spacing="0">
                <padding><Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Mis Cursos" styleClass="page-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtBuscar" promptText="Buscar curso..." prefWidth="220.0">
                        <tooltip><Tooltip text="Buscar cursos por nombre o descripción"/></tooltip>
                    </TextField>
                    <Button fx:id="btnCrearCurso" text="+ Nuevo Curso" mnemonicParsing="false">
                        <tooltip><Tooltip text="Crear un nuevo curso"/></tooltip>
                    </Button>
                </HBox>
                <Region minHeight="16.0" />
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                    <FlowPane fx:id="flowCursos" hgap="16.0" vgap="16.0" prefWrapLength="700.0">
                        <padding><Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/></padding>
                    </FlowPane>
                </ScrollPane>
            </VBox>

            <!-- ==== USUARIOS ==== -->
            <VBox fx:id="vboxUsuarios" spacing="16.0" visible="false">
                <padding><Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Usuarios" styleClass="page-title" />
                </HBox>
                <TextField fx:id="txtBuscar1" promptText="Buscar por nombre, apellidos o email...">
                    <tooltip><Tooltip text="Buscar usuarios"/></tooltip>
                </TextField>
                <TableView fx:id="tablaUsuarios1" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdUsuario1" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colNombre1" prefWidth="140.0" text="Nombre" />
                        <TableColumn fx:id="colApellidos1" prefWidth="150.0" text="Apellidos" />
                        <TableColumn fx:id="colEmail1" prefWidth="200.0" text="Email" />
                        <TableColumn fx:id="colTipo1" prefWidth="90.0" text="Rol" />
                        <TableColumn fx:id="colEdad1" prefWidth="60.0" text="Edad" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="btnVerPerfil1" text="Ver perfil" mnemonicParsing="false"
                            onAction="#handleVerPerfil">
                        <tooltip><Tooltip text="Ver perfil del usuario seleccionado"/></tooltip>
                    </Button>
                    <Button fx:id="btnExpulsar1" text="Eliminar usuario" mnemonicParsing="false"
                            styleClass="btn-danger" onAction="#handleExpulsar">
                        <tooltip><Tooltip text="Eliminar el usuario seleccionado"/></tooltip>
                    </Button>
                </HBox>
            </VBox>

            <!-- ==== MATRICULACIÓN ==== -->
            <VBox fx:id="vboxAsistencias" spacing="16.0" visible="false">
                <padding><Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Matriculación" styleClass="page-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnCrearMatricula" text="+ Nueva Matrícula" mnemonicParsing="false">
                        <tooltip><Tooltip text="Crear nueva matriculación"/></tooltip>
                    </Button>
                </HBox>
                <TextField fx:id="txtBuscar11" promptText="Buscar por nombre, apellidos o curso...">
                    <tooltip><Tooltip text="Buscar matriculaciones"/></tooltip>
                </TextField>
                <TableView fx:id="tablaUsuarios11" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdUsuarioAsistencia" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colNombre11" prefWidth="130.0" text="Nombre" />
                        <TableColumn fx:id="colApellidos11" prefWidth="140.0" text="Apellidos" />
                        <TableColumn fx:id="colFaltas11" prefWidth="70.0" text="Faltas" />
                        <TableColumn fx:id="colNota11" prefWidth="70.0" text="Nota" />
                        <TableColumn fx:id="colIdCursoAsistencia" prefWidth="60.0" text="ID Curso" />
                        <TableColumn fx:id="colNombreCursoAsistencia" prefWidth="160.0" text="Curso" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="btnInsertar" text="Editar nota/faltas" mnemonicParsing="false">
                        <tooltip><Tooltip text="Editar la matriculación seleccionada"/></tooltip>
                    </Button>
                    <Button fx:id="btnEliminarMatricula" text="Eliminar matrícula" mnemonicParsing="false"
                            styleClass="btn-danger">
                        <tooltip><Tooltip text="Eliminar la matriculación seleccionada"/></tooltip>
                    </Button>
                </HBox>
            </VBox>

            <!-- ==== TAREAS ==== -->
            <VBox fx:id="vboxTareas" spacing="16.0" visible="false">
                <padding><Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Tareas y Entregas" styleClass="page-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnCrearTarea" text="+ Nueva Tarea" mnemonicParsing="false">
                        <tooltip><Tooltip text="Crear nueva tarea"/></tooltip>
                    </Button>
                </HBox>
                <TableView fx:id="tablaTareas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTareaTitulo" prefWidth="220.0" text="Título" />
                        <TableColumn fx:id="colTareaCurso" prefWidth="160.0" text="Curso" />
                        <TableColumn fx:id="colTareaFechaLimite" prefWidth="140.0" text="Fecha límite" />
                        <TableColumn fx:id="colTareaPuntuacion" prefWidth="90.0" text="Puntuación" />
                        <TableColumn fx:id="colTareaEstado" prefWidth="120.0" text="Estado" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="btnVerTarea" text="Ver / Entregar" mnemonicParsing="false">
                        <tooltip><Tooltip text="Ver detalles o entregar la tarea"/></tooltip>
                    </Button>
                    <Button fx:id="btnEliminarTarea" text="Eliminar" mnemonicParsing="false"
                            styleClass="btn-danger">
                        <tooltip><Tooltip text="Eliminar la tarea seleccionada"/></tooltip>
                    </Button>
                </HBox>
            </VBox>

            <!-- ==== FORO ==== -->
            <VBox fx:id="vboxForo" spacing="16.0" visible="false">
                <padding><Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Foro de Discusión" styleClass="page-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnCrearHilo" text="+ Nuevo Hilo" mnemonicParsing="false">
                        <tooltip><Tooltip text="Crear nuevo hilo de discusión"/></tooltip>
                    </Button>
                </HBox>
                <TableView fx:id="tablaForo" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colForoTitulo" prefWidth="260.0" text="Título" />
                        <TableColumn fx:id="colForoAutor" prefWidth="130.0" text="Autor" />
                        <TableColumn fx:id="colForoCurso" prefWidth="160.0" text="Curso" />
                        <TableColumn fx:id="colForoFecha" prefWidth="150.0" text="Fecha" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="btnVerHilo" text="Ver hilo / Responder" mnemonicParsing="false">
                        <tooltip><Tooltip text="Ver el hilo y responder"/></tooltip>
                    </Button>
                    <Button fx:id="btnEliminarHilo" text="Eliminar" mnemonicParsing="false"
                            styleClass="btn-danger">
                        <tooltip><Tooltip text="Eliminar el hilo seleccionado"/></tooltip>
                    </Button>
                </HBox>
            </VBox>

            <!-- ==== ASISTENCIA ==== -->
            <VBox fx:id="vboxControlAsistencia" spacing="16.0" visible="false">
                <padding><Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Control de Asistencia" styleClass="page-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnRegistrarAsistencia" text="+ Registrar" mnemonicParsing="false">
                        <tooltip><Tooltip text="Registrar asistencia de un alumno"/></tooltip>
                    </Button>
                </HBox>
                <TableView fx:id="tablaControlAsistencia" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colAsistNombre" prefWidth="160.0" text="Alumno" />
                        <TableColumn fx:id="colAsistCurso" prefWidth="160.0" text="Curso" />
                        <TableColumn fx:id="colAsistFecha" prefWidth="100.0" text="Fecha" />
                        <TableColumn fx:id="colAsistEstado" prefWidth="110.0" text="Estado" />
                        <TableColumn fx:id="colAsistObservaciones" prefWidth="210.0" text="Observaciones" />
                    </columns>
                </TableView>
            </VBox>

            <!-- ==== NOTICIAS EDUCATIVAS ==== -->
            <VBox fx:id="vboxNoticias" spacing="0" visible="false">
                <padding><Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Noticias Educativas" styleClass="page-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnCargarNoticias" text="Cargar noticias" mnemonicParsing="false">
                        <tooltip><Tooltip text="Obtener las últimas noticias educativas de Internet"/></tooltip>
                    </Button>
                </HBox>
                <Label fx:id="lblEstadoNoticias"
                       text="Pulsa 'Cargar noticias' para obtener las últimas noticias educativas."
                       styleClass="status-label">
                    <VBox.margin><Insets top="8.0" bottom="8.0"/></VBox.margin>
                </Label>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                    <VBox fx:id="vboxListaNoticias" spacing="10.0">
                        <padding><Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
